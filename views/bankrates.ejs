<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="utf-8">
        <%-include('partials/header1.ejs') %>
    </head>
    <body>
        <% if(loggedIn){ %>
    <%- include('partials/navbar2.ejs') %>
        <% }else{ %>
            <%- include('partials/navbar1.ejs') %>
                <% } %>

        <div class="container mt-4">
    <h2 class="mt-4 mb-3 text-dark">Bank Rates</h2>

    <!-- Everyday Accounts table-->
     <h3 class="mt-4 mb-3 text-secondary">Everyday Accounts</h3>
        <table style="margin-bottom: 80px;" class="filter-table sortable-table table table-bordered" border="1">
            <thead>
            <tr>
                <th>Bank <button class="btn btn-sm btn-outline-secondary sort-btn" data-col="0">▲▼</button></th>
                <th>Account Name</th>
                <th>Accounttype</th>
                <th>Interest rate <button class="sort-btn" data-col="3">▲▼</button></th>
                <th>Period</th>
                <th>Accountfee</th>
                <th>Description</th>
            </tr>

    
            </thead>

            <tbody>

            <% interest
                .filter(i => i.accountname == 'Everyday')
                .forEach(function(int) { %>
            <tr>
                <td><%= int.bankname %></td>
                <td><%= int.accountname %></td>
                <td><%= int.accounttype %></td>
                <td><%= int.interestrate%></td>
                <td><%= int.period %></td>
                <td><%= int.accountfee %></td>
                <td><%= int.description %></td>
            </tr>
        <% }); %>

        </tbody>
        </table>

        <!-- Savings On Call Accounts table-->
         <h3 class="mt-4 mb-3 text-secondary">Savings On Call accounts</h3>
  
            <table style="margin-bottom: 80px;" class="filter-table sortable-table table table-bordered" border="1">
                <thead>
                <tr>
                    <th>Bank <button class="sort-btn" data-col="0">▲▼</button></th>
                    <th>Account Name</th>
                    <th>Accounttype</th>
                    <th>Interest rate <button class="sort-btn" data-col="3">▲▼</button></th>
                    <th>Period</th>
                    <th>Accountfee</th>
                    <th>Description</th>
                </tr>

            </thead>

            <tbody>

                <% interest
                    .filter(i => i.accountname == 'Savings-On Call')
                    .forEach(function(int) { %>
                <tr>
                    <td><%= int.bankname %></td>
                    <td><%= int.accountname %></td>
                    <td><%= int.accounttype %></td>
                    <td><%= int.interestrate %></td>
                    <td><%= int.period %></td>
                    <td><%= int.accountfee %></td>
                    <td><%= int.description %></td>
                </tr>
            <% }); %>
            </tbody>
            </table>


            <!-- Savings Long Term Accounts table-->
         <h3 class="mt-4 mb-3 text-secondary">Savings Long Term accounts</h3>
      
            <table class="sortable-table table table-bordered" border="1">
                <thead>
                <tr>
                    <th>Bank <button class="sort-btn" data-col="0">▲▼</button></th>
                    <th>Account Name</th>
                    <th>Accounttype</th>
                    <th>Interest rate <button class="sort-btn" data-col="3">▲▼</button></th>
                    <th>Period</th>
                    <th>Accountfee</th>
                    <th>Description</th>
                </tr>
                </thead>

                <tbody>

                <% interest
                    .filter(i => i.accountname == 'Savings')
                    .forEach(function(int) { %>
                <tr>
                    <td><%= int.bankname %></td>
                    <td><%= int.accountname %></td>
                    <td><%= int.accounttype %></td>
                    <td><%= int.interestrate %></td>
                    <td><%= int.period %></td>
                    <td><%= int.accountfee %></td>
                    <td><%= int.description %></td>
                </tr>
            <% }); %>
            </tbody>
            </table>

    

    </div>

<script>
function sortTable(table, colIndex, asc) {
    const tbody = table.querySelector("tbody");
    const rows = Array.from(tbody.querySelectorAll("tr"));

    const sorted = rows.sort((a, b) => {
        let A = a.cells[colIndex].innerText.trim();
        let B = b.cells[colIndex].innerText.trim();

        // Numeric sort (interest rate)
        const numA = parseFloat(A);
        const numB = parseFloat(B);

        if (!isNaN(numA) && !isNaN(numB)) {
            return asc ? numA - numB : numB - numA;
        }

        // Text sort (bank name)
        return asc ? A.localeCompare(B) : B.localeCompare(A);
    });

    sorted.forEach(row => tbody.appendChild(row));
}

document.querySelectorAll(".sort-btn").forEach(btn => {
    btn.addEventListener("click", function() {
        const colIndex = Number(this.dataset.col);
        const table = this.closest("table");

        // Toggle ascending/descending
        const asc = !this.classList.contains("asc");
        this.classList.toggle("asc", asc);

        sortTable(table, colIndex, asc);
    });
});
</script>


<!-- Bootstrap JS (must be at bottom)-->
 <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

    </body>
</html>


