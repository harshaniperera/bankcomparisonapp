<html>

<head>
    <%-include('partials/header1.ejs') %>
</head>

<body>
    <%-include('partials/navbar2.ejs') %>
        <div class="container mt-4">
            <h2 class="mt-4 mb-3 text-dark">Community Discussion</h2>

            <!-- Comment Form-->
            <form action="/discussion" method="POST" class="mb-4">
                <div class="mb-3">
                    <input type="text" id="comment" class="form-control w-40" placeholder="Comment" name="comment" required>
                </div>
                <button type="submit" class="btn btn-primary">Submit</button>
            </form>



            <!-- Discussion Posts -->
            <% discussion.forEach(function(item){ %>
                <div class="card mb-3">
                    <div class="card-body">

                        <!-- Main Comment-->
                        <h5 class="card-title">
                            <%= item.comment %>
                        </h5>

                        <!-- Reply Form-->
                        <form action="/discussionreply" method="POST" style="margin-top:10px;">
                            <input type="hidden" name="postid" value="<%= item.id %>">

                            <div class="input-group mb-2">
                                <input type="text" name="comment" class="form-control" placeholder="Write a reply..."
                                    required>
                                <button class="btn btn-success" type="submit">Reply</button>
                            </div>
                        </form>


                        <!-- Replies-->
                        <% if (item.replies) { %>
                            <ul class="list-group list-group-flush mt-3">
                                <% item.replies.forEach(function(rep){ %>
                                    <li class="list-group-item">
                                        <%= rep.comment %>
                                            <span class="text-muted small">
                                                (on <%= rep.date %>)
                                            </span>
                                    </li>
                                    <% }) %>
                            </ul>
                        <% } %>
                    </div>
                </div>
            <% }) %>
        </div>
</body>

</html>